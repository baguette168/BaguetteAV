<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F4F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FAFBFC</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="SidebarHoverColor">#F2F4F6</Color>
    <Color x:Key="SidebarActiveColor">#E9F6F1</Color>
    <Color x:Key="AccentColor">#0AA678</Color>
    <Color x:Key="AccentDarkColor">#088A64</Color>
    <Color x:Key="AccentSoftColor">#E9F6F1</Color>
    <Color x:Key="TextPrimaryColor">#151A21</Color>
    <Color x:Key="TextSecondaryColor">#5B6674</Color>
    <Color x:Key="TextMutedColor">#8A94A2</Color>
    <Color x:Key="BorderColor">#E2E5E9</Color>
    <Color x:Key="BorderStrongColor">#D2D7DD</Color>
    <Color x:Key="DangerColor">#C7443E</Color>
    <Color x:Key="DangerSoftColor">#FBEDEC</Color>
    <Color x:Key="WarningColor">#A9761B</Color>
    <Color x:Key="WarningSoftColor">#FBF3E4</Color>
    <Color x:Key="InfoColor">#2F6FEB</Color>
    <Color x:Key="InfoSoftColor">#ECF2FD</Color>
    <Color x:Key="SuccessColor">#0AA678</Color>
    <Color x:Key="SuccessSoftColor">#E9F6F1</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
</ResourceDictionary>
