<UserControl x:Class="BaguetteAV.EDR.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BaguetteAV.EDR.App.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="响应与处置" Style="{StaticResource H2}" />
                    <TextBlock Text="选择检测命中后的处置方式，并配置外联阻断行为" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <RadioButton Content="仅告警" GroupName="Response" IsChecked="{Binding AutoContain, Converter={StaticResource InverseBool}}" />
                        <RadioButton Content="自动处置" GroupName="Response" Margin="24,0,0,0" IsChecked="{Binding AutoContain}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox Content="自动隔离命中文件" IsChecked="{Binding AutoQuarantine}" VerticalAlignment="Center" />
                        <CheckBox Content="自动阻断 C2 外联" IsChecked="{Binding BlockC2}" Margin="28,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="监控范围" Style="{StaticResource H2}" />
                    <TextBlock Text="选择需要启用的实时监控数据源" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MonitorNetwork}" />
                            <TextBlock Text="网络与 C2 外联" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MonitorDrivers}" />
                            <TextBlock Text="文件创建监控" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MonitorWmi}" />
                            <TextBlock Text="WMI 事件" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MonitorFileCreation}" />
                            <TextBlock Text="驱动加载监控" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="检测规则" Style="{StaticResource H2}" />
                    <TextBlock Text="规则可单独启用或停用，保存后立即生效" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Mitre}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="存储与引擎" Style="{StaticResource H2}" />
                    <TextBlock Text="设置隔离区目录、ClamAV 引擎路径与默认扫描路径" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="隔离区目录" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding QuarantinePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding BrowseQuarantinePathCommand}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="clamscan.exe" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding ClamAvPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding BrowseClamAvPathCommand}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="默认扫描路径" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="浏览" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding BrowseScanPathCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="数据保留" Style="{StaticResource H2}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="告警保留天数" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="内存中最大告警数" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Text="{Binding MaxDetections, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" />
                <TextBlock Text="{Binding SettingsSavedText}" Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
