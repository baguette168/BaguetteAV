<UserControl x:Class="BaguetteAV.EDR.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BaguetteAV.EDR.App.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="隔离区" Style="{StaticResource H3}" />
                <TextBlock Text="已隔离文件以 .qtn 格式保存，可随时恢复或永久删除" Style="{StaticResource Caption}" Margin="12,2,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="恢复文件" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreQuarantineCommand}" />
                <Button Content="永久删除" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding DeleteQuarantineCommand}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding QuarantineItems.Count, Converter={StaticResource ZeroVis}}">
                    <TextBlock Text="隔离区为空" Style="{StaticResource H3}" HorizontalAlignment="Center" />
                    <TextBlock Text="被隔离的文件会显示在这里，可从隔离区恢复或删除" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <DataGrid Style="{StaticResource EdrGrid}" ItemsSource="{Binding QuarantineItems}" SelectedItem="{Binding SelectedQuarantine}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName, Mode=OneWay}" Width="180" />
                        <DataGridTextColumn Header="原始路径" Binding="{Binding OriginalPath, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="隔离时间" Binding="{Binding TimeText, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="大小" Binding="{Binding Size, Mode=OneWay, StringFormat={}{0:N0} B}" Width="100" />
                        <DataGridTextColumn Header="命中规则" Binding="{Binding RuleName, Mode=OneWay}" Width="160" />
                        <DataGridTextColumn Header="原文件已移除" Binding="{Binding OriginalRemoved, Mode=OneWay}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
