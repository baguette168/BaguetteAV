<UserControl x:Class="BaguetteAV.EDR.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BaguetteAV.EDR.App.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NotNull" />
        <conv:InverseNullToVisibilityConverter x:Key="IsNull" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="进程列表" Style="{StaticResource H3}" VerticalAlignment="Center" />
                <TextBlock Text="显示当前系统运行的进程与签名状态" Style="{StaticResource Caption}" Margin="12,2,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="刷新" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding RefreshProcessesCommand}" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <DataGrid Style="{StaticResource EdrGrid}" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="进程名" Binding="{Binding Name, Mode=OneWay}" Width="150" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId, Mode=OneWay}" Width="64" />
                        <DataGridTextColumn Header="父进程" Binding="{Binding ParentName, Mode=OneWay}" Width="130" />
                        <DataGridTemplateColumn Header="签名" Width="84">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未签名" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSigned}" Value="True">
                                                        <Setter Property="Text" Value="已签名" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="镜像路径" Binding="{Binding ImagePath, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256, Mode=OneWay}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding SelectedProcess, Converter={StaticResource IsNull}}">
                        <TextBlock Text="未选择进程" Style="{StaticResource H3}" HorizontalAlignment="Center" />
                        <TextBlock Text="在左侧列表中选择进程查看详细信息" Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedProcess, Converter={StaticResource NotNull}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProcess.Name}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding SelectedProcess.ImagePath}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PID" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding SelectedProcess.ProcessId}" Style="{StaticResource H3}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="父进程" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding SelectedProcess.ParentName}" Style="{StaticResource H3}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="SHA256" Style="{StaticResource Caption}" Margin="0,16,0,2" />
                            <TextBlock Text="{Binding SelectedProcess.Sha256}" Style="{StaticResource Caption}" FontFamily="Consolas" TextWrapping="Wrap" />
                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="10" Padding="12" Margin="0,16,0,0"
                                    Visibility="{Binding SelectedProcess.IsUserWritable, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="终止系统关键进程可能导致系统不稳定，请谨慎操作。" Style="{StaticResource Caption}" Foreground="#8A5A00" TextWrapping="Wrap" />
                            </Border>
                            <Button Content="终止进程" Style="{StaticResource DangerButton}" Margin="0,18,0,0"
                                    Command="{Binding KillSelectedProcessCommand}" HorizontalAlignment="Stretch" />
                            <Button Content="隔离文件" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                    Command="{Binding QuarantineSelectedProcessCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
