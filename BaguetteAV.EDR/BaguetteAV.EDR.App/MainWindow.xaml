<Window x:Class="BaguetteAV.EDR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:BaguetteAV.EDR.App.Views"
        xmlns:conv="clr-namespace:BaguetteAV.EDR.App.Converters"
        Title="B-EDR" Width="1120" Height="720" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="BoolBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,16,0,14">
                        <Border Width="34" Height="34" CornerRadius="8" Background="White">
                            <Image Source="/Assets/EDRlogo.png" Stretch="Uniform" Margin="2">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,30,30" RadiusX="6" RadiusY="6" />
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock Text="B-EDR" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"
                                   FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}" Background="Transparent"
                             BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="38" />
                                <Setter Property="Margin" Value="8,1" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                                                <Grid>
                                                    <Rectangle x:Name="Bar" Width="2" Height="18" RadiusX="1" RadiusY="1"
                                                               Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12,18,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding IsProtected, Converter={StaticResource BoolBrush}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding SysmonStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0,6,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="管理员" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding IsProtected, Converter={StaticResource BoolBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource AccentDarkBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="Minimize_Click" />
                            <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource WindowButton}" Click="Maximize_Click" />
                            <Button Content="&#xE8BB;" Style="{StaticResource WindowButton}" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,18">
                    <views:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}" />
                    <views:DetectionsView Visibility="{Binding IsDetections, Converter={StaticResource BoolToVis}}" />
                    <views:PoliciesView Visibility="{Binding IsPolicies, Converter={StaticResource BoolToVis}}" />
                    <views:ProcessesView Visibility="{Binding IsProcesses, Converter={StaticResource BoolToVis}}" />
                    <views:ScanView Visibility="{Binding IsScan, Converter={StaticResource BoolToVis}}" />
                    <views:QuarantineView Visibility="{Binding IsQuarantine, Converter={StaticResource BoolToVis}}" />
                    <views:LogsView Visibility="{Binding IsLogs, Converter={StaticResource BoolToVis}}" />
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
